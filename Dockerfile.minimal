# Minimal Dockerfile for Watermark Detector Pro (for platforms with build time limits)
FROM python:3.10-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install only essential system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copy application files
COPY backend.py .
COPY frontend/ ./frontend/
COPY best.pt .

# Install Python packages in separate steps to avoid index conflicts
RUN pip install --no-cache-dir --upgrade pip

# Install standard packages first
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    python-multipart \
    Pillow \
    numpy

# Install PyTorch CPU version from specific index
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Install remaining ML packages
RUN pip install --no-cache-dir \
    opencv-python-headless \
    ultralytics

# Create uploads directory
RUN mkdir -p uploads

# Expose port
EXPOSE 8000

# Simple health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=2 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["python", "backend.py"]