{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.minimal"
  },
  "deploy": {
    "startCommand": "python backend.py",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}